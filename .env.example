# Public port of the ASP.NET API.
API_PORT=8080

# Local port of the ComfyUI web interface.
COMFYUI_PORT=8188

# Host directory for generated PBR texture maps.
# Relative paths are resolved from the project directory.
RESULTS_PATH=./data/textures

# Optional ComfyUI command-line arguments.
# Leave empty to enable automatic VRAM detection.
COMFY_ARGS=